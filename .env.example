# --- Admin frontend protection (optional but recommended once deployed) ---
# If ADMIN_PASSWORD is unset, the dashboard is open to anyone with the URL.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Storage backend ---
# Connect a Redis database to this project from the Vercel dashboard
# (Storage tab -> Marketplace -> "Upstash Redis" or "Redis") and it will
# inject KV_REST_API_URL / KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN, both are supported) automatically — you don't
# need to fill them in by hand on Vercel.
# For local development, leave these blank and the app will fall back to an
# in-memory store (data resets whenever the dev server restarts).
KV_REST_API_URL=
KV_REST_API_TOKEN=
